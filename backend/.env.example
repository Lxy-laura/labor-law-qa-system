# ========== 劳动合同纠纷智能问答系统 - 环境变量配置 ==========
# 复制此文件为 .env 并填写实际值

# DeepSeek API 配置（必填！去 platform.deepseek.com 注册获取）
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.3

# JWT 认证配置（不用改）
JWT_SECRET=labor-law-qa-secret-key-2024
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 模型配置（不用改，模型会自动从 HuggingFace 下载）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.1
RERANKER_MODEL=BAAI/bge-reranker-base
LORA_MODEL_PATH=

# 应用配置（不用改）
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# 检索配置（不用改）
VECTOR_TOP_K=20
BM25_TOP_K=20
RERANK_TOP_K=5
RRF_K=60

# Milvus 向量数据库配置（可选，不装 Milvus 就不用改）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=labor_law_docs
MILVUS_DIMENSION=512
